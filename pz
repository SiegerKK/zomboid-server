}
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$ ]]; }
assert_name() { valid_name "$1" || die 'World name must be 1-40 characters, letters/digits/_/-; start with letter/digit'; }
profile_path() {
  case "$1" in
    vanilla) printf '%s\n' "$REPO/config/mods.vanilla.env" ;;
    tlou) printf '%s\n' "$REPO/config/mods.env" ;;
    mp-test) printf '%s\n' "$REPO/config/mods.mp-test.env" ;;
    *) die "Unknown mods profile: $1 (valid: vanilla, tlou, mp-test)" ;;
  esac
}
preset_path() {
  local preset="$1"
  [[ "$preset" == auto ]] && return 0
  assert_name "$preset"
  local file="$REPO/config/presets/$preset.lua"
  [[ -f "$file" && -s "$file" && ! -L "$file" ]] || die "Sandbox preset missing: $file"
  [[ "$(wc -c < "$file")" -le 1048576 ]] || die "Sandbox preset too large: $file"
  grep -Eq '^[[:space:]]*(SandboxVars[[:space:]]*=[[:space:]]*|return[[:space:]]*)[{]' "$file" || die "Unsupported SandboxVars format: $file"
  printf '%s\n' "$file"
}
check_server_rules() {
  local file="$1" line key value
  [[ -f "$file" && ! -L "$file" ]] || die "Server rules missing or symlink: $file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ "$line" =~ ^([A-Z_]+)=(.*)$ ]] || die "Invalid rules line in $file"
    key="${BASH_REMATCH[1]}" value="${BASH_REMATCH[2]}"
    case "$key" in
      PING_LIMIT) [[ "$value" =~ ^[0-9]{1,9}$ ]] || die 'PING_LIMIT must be 0-999999999 (0 disables ping kick)' ;;
      MAX_PLAYERS) [[ "$value" =~ ^[1-9][0-9]?$ ]] || die 'MAX_PLAYERS must be 1-99' ;;
      PVP|PAUSE_EMPTY|PUBLIC|OPEN|SLEEP_ALLOWED|SLEEP_NEEDED)
        [[ "$value" == true || "$value" == false ]] || die "Invalid boolean $key in $file" ;;
      *) die "Forbidden per-world key $key; secrets, ports and server name are immutable" ;;
    esac
  done < "$file"
}
rules_path() {
  local name="$1"
  assert_name "$name"
  local file="$REPO/config/server-rules/$name.env"
  check_server_rules "$file"
  printf '%s\n' "$file"
}
world_dir() { assert_name "$1"; printf '%s/%s\n' "$WORLDS" "$1"; }
world_exists() { [[ -d "$WORLDS/$1/data" && -f "$WORLDS/$1/profile" ]]; }
mod_set() { tr ';' '\n' | sed '/^$/d;s/\r$//' | LC_ALL=C sort -u; }
check_legacy_profile() {
  local profile="$1" ini="$LEGACY/Server/SiegerZomboid.ini" file key actual wanted
  file="$(profile_path "$profile")"
  [[ -f "$ini" ]] || die 'Legacy server configuration missing; verify profile manually before import'
  for key in Mods WorkshopItems; do
    actual="$(sed -n "s/^$key=//p" "$ini" | mod_set)"
    if [[ "$key" == Mods ]]; then key=MODS; else key=WORKSHOP_ITEMS; fi
    wanted="$(sed -n "s/^$key=//p" "$file" | mod_set)"
    [[ "$actual" == "$wanted" ]] || die "Legacy $key differs from profile $profile; import refused"
  done
}
world_profile() {
  local name="$1" profile
  world_exists "$name" || die "World is missing/unfinished: $name"
  IFS= read -r profile < "$WORLDS/$name/profile" || :
  [[ -n "$profile" ]] || die "World profile is empty: $name"
  [[ -f "$(profile_path "$profile")" ]] || die "Missing mods file for profile $profile"
  [[ -f "$WORLDS/$name/mods.env" ]] && cmp -s "$WORLDS/$name/mods.env" "$(profile_path "$profile")" || die "Profile $profile changed since world creation; review before starting $name"
  printf '%s\n' "$profile"
}
record_profile() {
  cp -- "$(profile_path "$2")" "$1/mods.env"
  {
    printf 'profile=%s\n' "$2"
    [[ ! -f "$REPO/DEPLOYED_COMMIT" ]] || cat "$REPO/DEPLOYED_COMMIT"
    grep '^PZ_IMAGE=' "$REPO/.env" || :
  } > "$1/deployment.txt"
}
active() {
  local name=''
  if [[ -f "$ACTIVE_FILE" ]]; then
    IFS= read -r name < "$ACTIVE_FILE" || :
    [[ -z "$name" ]] || assert_name "$name"
  fi
  printf '%s\n' "$name"
}
set_active() {
  local temp
  temp="$(mktemp "$STATE/.active.XXXXXX")"
  printf '%s\n' "$1" > "$temp"
  mv -f -- "$temp" "$ACTIVE_FILE"
}
container_state() { docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true; }
container_running() { [[ "$(container_state)" == true ]]; }
container_exists() { [[ -n "$(container_state)" ]]; }
check_mount() {
  local world="$1" actual expected
  container_exists || return 0
  actual="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/root/Zomboid"}}{{.Source}}{{end}}{{end}}' "$CONTAINER")"
  expected="$(realpath -m -- "$WORLDS/$world/data")"
  [[ "$actual" == "$expected" ]] || die "Container data mount is '$actual', but active world is '$expected'. STOP and investigate (legacy or external Compose)."
}
select_world() {
  local suggested="${1:-}" i choice
  if [[ -n "$suggested" ]]; then
    assert_name "$suggested"
    world_exists "$suggested" || die "World not found: $suggested"
    printf '%s\n' "$suggested"
    return
  fi
  local -a choices=()
  local entry
  for entry in "$WORLDS"/*; do
    [[ -d "$entry/data" && -f "$entry/profile" ]] && choices+=("${entry##*/}")
  done
  ((${#choices[@]})) || die 'No worlds. Use: pz create myworld [vanilla|tlou] (or pz import-legacy original).'
  [[ -t 0 ]] || die 'Noninteractive mode: specify a WORLD name'
  note 'Available worlds:'
  for ((i=0;i<${#choices[@]};i++)); do
    note "  $((i+1)). ${choices[i]} ($(world_profile "${choices[i]}"))"
  done
  read -r -p 'Select world number: ' choice
  [[ "$choice" =~ ^[0-9]+$ ]] || die 'Enter a number'
  ((10#$choice >= 1 && 10#$choice <= ${#choices[@]})) || die 'Selection out of range'
  printf '%s\n' "${choices[10#$choice-1]}"
}
confirm_interrupt() {
  local message="$1" yes="${2:-}"
  [[ "$yes" == '--yes' ]] && return 0
  [[ -t 0 ]] || die "$message (noninteractive: explicitly pass --yes)"
  note "$message"
  read -r -p 'Type YES to continue: ' response
  [[ "$response" == YES ]] || die 'Cancelled'
}
compose_for() {
  local name="$1" profile
  profile="$(world_profile "$name")"
  export PZ_WORLD_DATA_DIR="$WORLDS/$name/data"
  export PZ_MODS_FILE="$(profile_path "$profile")"
  if [[ -f "$WORLDS/$name/server-rules.env" ]]; then
    check_server_rules "$WORLDS/$name/server-rules.env"
    export PZ_WORLD_RULES_FILE="$WORLDS/$name/server-rules.env"
  else
    export PZ_WORLD_RULES_FILE="$(rules_path default)"
  fi
  COMPOSE=(docker compose --project-directory "$REPO" -f "$REPO/compose.yaml")
  if [[ "$profile" != vanilla ]]; then
    export PZ_WORKSHOP_SNAPSHOT="$STORE/mod-snapshot"
    [[ "$profile" != mp-test ]] || export PZ_WORKSHOP_SNAPSHOT="$STORE/mod-snapshot-mp-test"
    [[ -d "$PZ_WORKSHOP_SNAPSHOT/content/108600" && -f "$STORE/agent/ZombieBuddy.jar" ]] || die "Audited snapshot/agent missing for $profile; no downloads or profile substitution allowed"
    COMPOSE+=(-f "$REPO/compose.mods.yaml")
  fi
  if [[ -f "$WORLDS/$name/story/bundle.lua" ]]; then
    [[ ! -L "$WORLDS/$name/story/bundle.lua" ]] || die 'Story bundle must not be a symlink'
    PZ_STORY_REPO_ROOT="$REPO" PZ_STORY_STORE_ROOT="$STORE" \
      python3 "$REPO/story/storyctl.py" status "$name" >/dev/null || die 'Story bundle differs from reviewed sources; refusing start'
    export PZ_STORY_BUNDLE="$WORLDS/$name/story/bundle.lua"
    PZ_STORY_ADMIN_MODS="$(sed -n 's/^MODS=//p' "$PZ_MODS_FILE")"
    [[ "$PZ_STORY_ADMIN_MODS" =~ ^[A-Za-z0-9_\;]*$ ]] || die 'Invalid admin base mod list'
    [[ ";$PZ_STORY_ADMIN_MODS;" != *';SiegerAdmin;'* ]] || die 'SiegerAdmin already present in base profile'
    export PZ_STORY_ADMIN_MODS="${PZ_STORY_ADMIN_MODS:+$PZ_STORY_ADMIN_MODS;}SiegerAdmin"
    [[ -f "$REPO/mods/SiegerAdmin/42/mod.info" ]] || die 'Local SiegerAdmin pack missing'
    COMPOSE+=(-f "$REPO/compose.story.yaml")
    if [[ -f "$WORLDS/$name/story/radio.enabled" ]]; then
      [[ "$name" == story_test && ! -L "$WORLDS/$name/story/radio.enabled" ]] || die 'Local radio pack is approved only for story_test'
      # A Git pull over the old deployed SiegerRadio directory can leave
      # untracked Story modules behind. Refuse to run duplicate handlers.
      [[ -f "$REPO/scripts/admin_assets.py" ]] || die 'Admin package verifier missing'
      python3 "$REPO/scripts/admin_assets.py" check >/dev/null ||
        die 'Old or unreviewed SiegerAdmin/SiegerRadio Lua. Install both packs cleanly before start'
      PZ_STORY_RADIO_MODS="$PZ_STORY_ADMIN_MODS"
      [[ "$PZ_STORY_RADIO_MODS" =~ ^[A-Za-z0-9_\;]+$ ]] || die 'Invalid radio base mod list'
      [[ ";$PZ_STORY_RADIO_MODS;" != *';SiegerRadio;'* ]] || die 'SiegerRadio already present in base profile'
      export PZ_STORY_RADIO_MODS="$PZ_STORY_RADIO_MODS;SiegerRadio"
      [[ -f "$REPO/mods/SiegerRadio/42/mod.info" ]] || die 'Local SiegerRadio pack missing'
      COMPOSE+=(-f "$REPO/compose.radio.yaml")
    fi
  else
    unset PZ_STORY_BUNDLE || :
  fi
  [[ -f "$REPO/.env" ]] || die "VPS-only $REPO/.env not found"
  "${COMPOSE[@]}" config --quiet
}

rcon_command() {
  local cmd="$1"
  # Password is read from the CONTAINER environment, not expanded in host argv.
  # RCON port 27015 is internal only; it must not be published on the host.
  # A private tmpfs FIFO keeps the password out of argv and regular files.
  # YAML single-quoted scalars escape an apostrophe by doubling it.
  local output
  if ! output=$(timeout 30s docker exec "$CONTAINER" /bin/bash -c '
    set -euo pipefail
    [[ -n "${RCON_PASSWORD:-}" && "$RCON_PASSWORD" != *$'"'"'\n'"'"'* && "$RCON_PASSWORD" != *$'"'"'\r'"'"'* ]]
    p=${RCON_PASSWORD//\'"'"'/\'"'"'\'"'"'}
    d=$(mktemp -d /dev/shm/pz-rcon.XXXXXX)
    trap '\''rm -f -- "$d/config.yaml"; rmdir -- "$d"'\'' EXIT
    mkfifo -m 600 "$d/config.yaml"
    printf "default:\n  address: 127.0.0.1:27015\n  password: '\''%s'\''\n" "$p" > "$d/config.yaml" &
    rcon -T 15s -c "$d/config.yaml" "$1"
  ' _ "$cmd" </dev/null 2>/dev/null); then
    note 'RCON failed; secret-bearing diagnostics suppressed.'
    return 1
  fi
  if [[ "$cmd" == players ]]; then
    [[ "$output" =~ Players\ connected[[:space:]]*\(([0-9]+)\) ]] || return 1
    printf 'Players connected (%s):\n' "${BASH_REMATCH[1]}"
  else
    printf '%s\n' "$output"
  fi
}

stop_internal() {
  local name="$(active)"
  container_running || { note 'Game already stopped.'; return 0; }
  [[ -n "$name" ]] || die 'Active world unknown; stop legacy server manually before importing'
  check_mount "$name"
  compose_for "$name"
  note "Saving $name via RCON ..."
  rcon_command save || die 'Save failed; game left running, no cold backup made'
  docker update --restart=no "$CONTAINER" >/dev/null
  rcon_command quit || note 'Quit response failed; checking actual container exit.'
  local i
  for ((i=0;i<90;i++)); do container_running || break; sleep 2; done
  if container_running; then
    docker update --restart=unless-stopped "$CONTAINER" >/dev/null
    die 'Graceful quit timed out; game left running, no forced kill or backup'
  fi
  "${COMPOSE[@]}" stop -t 180 zomboid </dev/null
  docker update --restart=unless-stopped "$CONTAINER" >/dev/null
  local exit_code
  exit_code="$(docker inspect -f '{{.State.ExitCode}}' "$CONTAINER")"
  [[ "$exit_code" == 0 ]] || die "Unclean exit $exit_code; no cold backup until integrity is verified"
  note "Game stopped (exit code $exit_code)."
}

start_internal() {
  local name="$1" previous
  world_exists "$name" || die "World does not exist: $name"
  container_running && die 'A world is already running; stop it first'
  # Until legacy data is copied to a world slot, do not silently replace it.
  if [[ ! -f "$STATE/legacy-imported" && -d "$LEGACY" ]] && find "$LEGACY" -mindepth 1 -print -quit | grep -q .; then
    die "Existing legacy save at $LEGACY. First: sudo pz import-legacy original (server stopped)."
  fi
  compose_for "$name"
  note "Starting $name in background ..."
  "${COMPOSE[@]}" up -d --no-deps --force-recreate zomboid </dev/null || die "Failed to start Docker Compose for world $name"
  set_active "$name"
  check_mount "$name"
  note "Container started, selected world $name. Full game readiness may take several minutes. Check: sudo pz logs"
}

backup_world() {
  local name="$1" stamp dest file partial
  world_exists "$name" || die "No such world: $name"
  container_running && die 'Cold backup requires stopped game process'
  install -d -m 700 "$BACKUPS/$name"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  dest="$BACKUPS/$name"
  file="$dest/world-$stamp.tar.gz"
  partial="$file.partial"
  [[ ! -e "$file" && ! -e "$partial" ]] || die "Backup path already exists: $file"
  [[ -z "$(find "$WORLDS/$name/data" ! -type f ! -type d -print -quit)" ]] || { note 'Backup refuses links or special files'; return 1; }
  local -a members=(profile mods.env deployment.txt data)
  [[ ! -f "$WORLDS/$name/preset" ]] || members+=(preset)
  [[ ! -f "$WORLDS/$name/server-rules.env" ]] || members+=(server-rules.env)
  [[ ! -d "$WORLDS/$name/story" ]] || members+=(story)
  tar --hard-dereference --acls --xattrs --numeric-owner -czf "$partial" -C "$WORLDS/$name" "${members[@]}" || return 1
  tar -tzf "$partial" >/dev/null || return 1
  mv -- "$partial" "$file" || return 1
  (cd "$dest" && sha256sum -- "${file##*/}" > "${file##*/}.sha256") || return 1
  note "Cold backup verified: $file"
}

command_start() {
  (($# <= 1)) || die 'Usage: pz start [WORLD]'
  container_running && die 'Game already running; stop it before switching'
  local name
  name="$(select_world "${1:-}")"
  start_internal "$name"
}
command_stop() {
  (($# <= 1)) || die 'Usage: pz stop [--yes]'
  [[ "${1:-}" == '' || "${1:-}" == '--yes' ]] || die 'Usage: pz stop [--yes]'
  if container_running; then
    confirm_interrupt 'Stopping disconnects all players.' "${1:-}"
  fi
  stop_internal
}
command_save() {
  (($# <= 2)) || die 'Usage: pz save [WORLD] [--yes]'
  local name='' yes='' current was_running=false
  for arg in "$@"; do
    if [[ "$arg" == '--yes' ]]; then yes='--yes'; elif [[ -z "$name" ]]; then name="$arg"; else die 'Usage: pz save [WORLD] [--yes]'; fi
  done
  [[ -n "$name" ]] || name="$(active)"
  [[ -n "$name" ]] || die 'No active world. Specify: pz save WORLD'
  assert_name "$name"
  world_exists "$name" || die "World not found: $name"
  current="$(active)"
  if container_running; then
    [[ "$name" == "$current" ]] || die 'Cannot back up a different world while another is running'
    confirm_interrupt 'Cold backup temporarily stops the game and disconnects players.' "$yes"
    stop_internal
    was_running=true
  fi
  local rc=0
  backup_world "$name" || rc=$?
  if [[ "$was_running" == true ]]; then
    note 'Restarting the previously running world ...'
    start_internal "$name" || die 'Backup finished/failed, but restart failed. Check Docker manually.'
  fi
  ((rc == 0)) || die 'Backup failed; old world was not deleted'
}
command_save_live() {
  (($# == 0)) || die 'Usage: pz save-live'
  container_running || die 'Game is not running'
  local name
  name="$(active)"
  [[ -n "$name" ]] || die 'Active world unknown'
  check_mount "$name"
  rcon_command save
  note 'RCON save requested. This is not a restorable cold backup: use pz save for a snapshot.'
}
command_create() {
  (($# >= 1 && $# <= 4)) || die 'Usage: pz create WORLD [vanilla|tlou|mp-test] [PRESET|auto] [RULES|default]'
  local name="$1" profile="vanilla" preset="auto" rules="default" dest tmp sandbox_source
  (($# < 2)) || profile="$2"
  (($# < 3)) || preset="$3"
  (($# < 4)) || rules="$4"
  assert_name "$name"
  [[ -f "$(profile_path "$profile")" ]] || die 'Mod profile file missing'
  sandbox_source="$(preset_path "$preset")"
  rules_path "$rules" >/dev/null
  dest="$(world_dir "$name")"
  [[ ! -e "$dest" ]] || die "World already exists: $name"
  tmp="$(mktemp -d "$WORLDS/.create.XXXXXX")"
  mkdir -m 700 "$tmp/data"
  if [[ "$preset" != auto ]]; then
    mkdir -m 700 "$tmp/data/Server"
    cp -- "$sandbox_source" "$tmp/data/Server/SiegerZomboid_SandboxVars.lua"
  fi
  printf '%s\n' "$profile" > "$tmp/profile"
  printf '%s\n' "$preset" > "$tmp/preset"
  cp -- "$(rules_path "$rules")" "$tmp/server-rules.env"
  record_profile "$tmp" "$profile"
  mv -- "$tmp" "$dest"
  note "Created $name (mods=$profile, sandbox=$preset, rules=$rules)."
  note 'Preset and server rules are independent snapshots; Git edits do not rewrite this world.'
  note "Start with: sudo pz start $name"
}

command_import() {
  (($# == 2)) || die 'Usage: pz import-legacy NEW_WORLD_NAME PROFILE (vanilla|tlou|mp-test)'
  local name="$1" profile="$2" dest tmp
  assert_name "$name"
  [[ -f "$(profile_path "$profile")" ]] || die 'Mod profile file missing'
  container_running && die 'Stop the legacy server before importing its data (no hot copy)'
  [[ -d "$LEGACY" ]] || die "Legacy world data missing: $LEGACY"
  find "$LEGACY" -mindepth 1 -print -quit | grep -q . || die 'Legacy directory is empty'
  check_legacy_profile "$profile"
  dest="$(world_dir "$name")"
  [[ ! -e "$dest" ]] || die "Destination slot exists: $name"
  tmp="$(mktemp -d "$WORLDS/.import.XXXXXX")"
  cp -a -- "$LEGACY" "$tmp/data"
  printf '%s\n' "$profile" > "$tmp/profile"
  printf 'imported\n' > "$tmp/preset"
  cp -- "$(rules_path default)" "$tmp/server-rules.env"
  record_profile "$tmp" "$profile"
  mv -- "$tmp" "$dest"
  # The legacy data has now been copied; never remove or repurpose the source.
  note "Copied legacy save to $name. Original $LEGACY remains untouched."
  note 'For safety, make and verify an initial cold backup before starting this slot.'
  backup_world "$name" || die 'Import copy retained, but backup failed; legacy-imported marker not written'
  : > "$STATE/legacy-imported"
}
command_list() {
  local name profile sel
  sel="$(active)"
  printf '%-24s %-12s %-16s %s\n' WORLD PROFILE PRESET SELECTED
  for dir in "$WORLDS"/*; do
    [[ -d "$dir/data" && -f "$dir/profile" ]] || continue
    name="${dir##*/}"
    profile="$(world_profile "$name")"
    local preset='auto'
    [[ ! -f "$dir/preset" ]] || IFS= read -r preset < "$dir/preset"
    if [[ "$name" == "$sel" ]]; then printf '%-24s %-12s %-16s %s\n' "$name" "$profile" "$preset" '*';
    else printf '%-24s %-12s %-16s\n' "$name" "$profile" "$preset"; fi
  done
}
command_status() {
  local name="$(active)" state="$(container_state)"
  printf 'Selected world: %s\n' "${name:-none}"
  printf 'Docker container: %s\n' "${state:-absent}"
  if [[ -n "$name" && -n "$state" ]]; then check_mount "$name"; fi
  if [[ -n "$name" && -f "$WORLDS/$name/preset" ]]; then
    printf 'Sandbox preset snapshot: %s\n' "$(cat "$WORLDS/$name/preset")"
  fi
  if [[ -n "$name" && -f "$WORLDS/$name/server-rules.env" ]]; then
    grep '^PAUSE_EMPTY=' "$WORLDS/$name/server-rules.env" || true
