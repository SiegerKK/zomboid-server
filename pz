#!/usr/bin/env bash
# Manage independent Project Zomboid worlds from ONE Docker Compose repository.
# Install as a symlink to the root-owned repository: ln -s /opt/zomboid-server/pz /usr/local/sbin/pz
set -Eeuo pipefail
umask 077

SCRIPT_FILE="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO="${PZ_MANAGER_REPO_ROOT:-$(dirname -- "$SCRIPT_FILE")}"  # test override; root execution only
STORE="${PZ_MANAGER_STORE_ROOT:-/srv/zomboid}"             # test override; root execution only
WORLDS="$STORE/worlds"
BACKUPS="$STORE/backups/worlds"
STATE="$STORE/manager"
ACTIVE_FILE="$STATE/active-world"
LEGACY="$STORE/data"
LOCK="${PZ_MANAGER_LOCK_FILE:-/run/lock/pz-operation.lock}"
CONTAINER=zomboid-server
COMPOSE=(docker compose --project-directory "$REPO" -f "$REPO/compose.yaml")

usage() {
  cat <<'HELP'
Usage: sudo pz COMMAND [args]

  start [WORLD]             Select world by number (or name) and run in background
  stop [--yes]              Gracefully save and stop the container
  save [WORLD] [--yes]      Cold, verifiable backup; stops/restarts if running
  save-live                 Send the game's RCON save command (not a backup)
  load [ARCHIVE] [NEW]      Restore a backup to a NEW, separate world slot
  create WORLD [PROFILE] [PRESET] [RULES]   Create an isolated world
  config WORLD              Show a world's config and sandbox file paths
  export-preset WORLD NAME  Copy a stopped world's current sandbox into Git
  admin grant USER          Give in-game admin rights to an existing player
  admin revoke USER         Revoke the in-game admin role
  story validate FILE       Validate JSON story without running game actions
  story preview FILE        Print planned actions and missing coordinates
  story inspect WORLD X Y Z --yes  Stage read-only square inspection
  story apply WORLD FILE --yes     Stage scene after recent cold backup
  story status WORLD        Show the staged story bundle
  story scan-player WORLD GAME_LOGIN --yes   Legacy scan
  story scan-area WORLD --player LOGIN --radius R --z-min Z --z-max Z --yes
  story apply-once WORLD --key STABLE --type loot --x X --y Y --z Z --item Base.Bandage --purpose TEXT --yes
  story player-inspect WORLD LOGIN --yes   Online health and inventory
  story player-status WORLD
  story player-grant WORLD LOGIN --item Base.Bandage --count 1 --yes
  story player-remove-tagged WORLD LOGIN --token STORY_TOKEN --yes
  story player-heal WORLD LOGIN --experimental-health --yes
  story teleport WORLD LOGIN X Y Z [--yes]    Native server teleport (preview first)
  story profile WORLD --samples 12 --interval 5
  story character repair WORLD LOGIN --profile joel-arrival-v1 [--item Base.Revolver] [--yes]  Server-owned equipment
  story character status WORLD     Client acknowledgement; verify in game
  story atlas capture WORLD --bbox X0,Y0,X1,Y1 --floors 0:4 --yes   Metagrid buildings
  story atlas status WORLD                 Atlas progress / exact receipt
  story atlas stop WORLD --yes           Abort only the Atlas scan
  story atlas export WORLD --output NEW.json [--geojson NEW.geojson]
  story atlas analyze --atlas FILE.json --trace TRACE.json --output NEW.json
  story atlas analyze --atlas FILE.json --roster ROSTER.json --source-world WORLD --output NEW.json
  story zombies snapshot WORLD --yes  Detailed read-only loaded zombie snapshot
  story zombies record WORLD --seconds N [--interval-ms 1000] --yes  Timed private trace
  story zombies status WORLD          Capture state/coverage/limits
  story zombies stop WORLD --yes      Stop recording only, not game
  story zombies report WORLD [--id ID] [--output NEW.json]  Private full trace
  story zombies analyze WORLD [--id ID] [--output NEW.json]  Per-zombie transitions
  story time show WORLD             Request a live clock snapshot (also when empty/paused)
  story time set WORLD HH:MM --yes   Set same-date clock; players refused by default
  story time advance WORLD MINUTES --yes   Jump 1..1440 minutes, not simulation
  story time status WORLD           Inspect exact clock acknowledgement
  story ops players WORLD --yes       Online players, coordinates and vehicle IDs
  story ops nearby WORLD --player LOGIN --radius 10 --yes    Nearby loaded threats
  story ops result WORLD             Inspect exact server snapshot result
  story tlou registry WORLD --yes    TLOU/ZomboidForge active definitions; no entity scan
  story tlou census WORLD --yes      ONE full pass over all loaded infected
  story tlou roster WORLD --player LOGIN --yes  All loaded infected, types and distances
  story tlou result WORLD [--output NEW.json]   Exact snapshot/private JSON export
  story build preview WORLD --file PLAN.json --stage ID  Read-only construction stage
  story build apply WORLD --file PLAN.json --stage ID --yes  Queue ONE stage
  story build status WORLD                       Last stage / partial failure
  story batch preview WORLD --file PLAN.json        Preview grouped vehicle/player/item actions
  story batch apply WORLD --file PLAN.json --yes    Queue reviewed edit batch
  story batch status WORLD                         Read last server receipt
  story vehicle inspect WORLD --id ID --script Base.NAME --x X --y Y --z Z
  story vehicle condition WORLD --id ID --script Base.NAME --x X --y Y --z Z --part ID --expect N --value N
  story vehicle status WORLD         Confirm result of exact guarded request
  story bar-zombies inspect WORLD --yes          Count loaded zombies in Smokey's
  story bar-zombies clear WORLD --expect N --yes Clear exactly N zombies from bar
  story bar-zombies-status WORLD                Inspect last clearance result
  story radio text WORLD --frequency 101.3 --source X,Y --text TEXT [--yes]  Native radio text
  story radio audio WORLD --frequency 101.3 --source X,Y --clip test_tone --allow-audio [--yes]
  story radio status WORLD                 Last transmission server ACK
  story radio clips WORLD                  Available registered audio clips
  story scan-status WORLD   Check status and nearby container coordinates
  story scan-report WORLD --json   Full items/objects with exact coordinates
  story live-begin WORLD --yes     Cold BEFORE backup, then run game and enable edits
  story retry-height WORLD --yes          Retry proven pre-placement height errors only
  story apply-live WORLD SCENE --yes   Queue reviewed note/loot in running game
  story apply-live WORLD SCENE --allow-infected --yes   Opt-in vanilla live zombies
  story apply-live WORLD SCENE --allow-corpses --yes    Opt-in live corpse and ground revolver
  story quest-status WORLD QUEST [--json]   Private quest spawn/death ledger
  story live-status WORLD        Show game acknowledgements, pending actions
  story live-commit WORLD --yes    Cold AFTER backup, permanently mark checkpoint
  import-legacy WORLD PROFILE  Copy legacy data into a world slot (profile required)
  list                      Show saved world slots and mod profiles
  status                    Show active slot and container state
  logs                      Follow game logs (Ctrl+C exits the log viewer)

All actions require root via sudo. A world holds all /root/Zomboid data,
including player database, saves and configuration. No live world is overwritten.
PAUSE_EMPTY=true pauses GAME TIME only; pz stop frees the running game resources.
