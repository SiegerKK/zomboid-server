  name="$(active)"
  [[ -n "$name" ]] || die 'No selected world'
  compose_for "$name"
  flock -u 9
  exec "${COMPOSE[@]}" logs -f --tail 100 zomboid
}
command_load() {
  (($# <= 2)) || die 'Usage: pz load [BACKUP_PATH] [NEW_WORLD_NAME]'
  container_running && die 'Stop the game before restoring a backup into a new slot'
  local archive="${1:-}" new="${2:-}" i choice temp dest entry
  if [[ -z "$archive" ]]; then
    local -a choices=()
    while IFS= read -r -d '' entry; do choices+=("$entry"); done < <(find "$BACKUPS" -type f -name 'world-*.tar.gz' -print0 | sort -z)
    ((${#choices[@]})) || die 'No cold backups available'
    [[ -t 0 ]] || die 'Noninteractive mode: provide BACKUP_PATH and NEW_WORLD_NAME'
    note 'Available cold backups:'
    for ((i=0;i<${#choices[@]};i++)); do note "  $((i+1)). ${choices[i]##"$BACKUPS/"}"; done
    read -r -p 'Select backup number: ' choice
    [[ "$choice" =~ ^[0-9]+$ ]] || die 'Enter a number'
    ((10#$choice >= 1 && 10#$choice <= ${#choices[@]})) || die 'Selection out of range'
    archive="${choices[10#$choice-1]}"
  fi
  [[ -f "$archive" && "$archive" == "$BACKUPS/"* && "$archive" == *.tar.gz ]] || die 'Only manager-created archive paths under backups/worlds are accepted'
  [[ -f "$archive.sha256" ]] || die "Checksum is missing: $archive.sha256"
  archive="$(realpath -e -- "$archive")"
  [[ "$archive" == "$(realpath -e -- "$BACKUPS")/"* ]] || die 'Archive escapes backup directory'
  local checksum actual
  checksum="$(cat -- "$archive.sha256")"
  [[ "$checksum" =~ ^([a-f0-9]{64})[[:space:]][[:space:]]([^/]+)$ && "${BASH_REMATCH[2]}" == "${archive##*/}" ]] || die 'Invalid checksum sidecar'
  checksum="${BASH_REMATCH[1]}"
  actual="$(sha256sum -- "$archive")"; actual="${actual%% *}"
  [[ "$actual" == "$checksum" ]] || die 'Backup SHA-256 mismatch'
  if [[ -z "$new" ]]; then
    [[ -t 0 ]] || die 'Noninteractive mode: specify NEW_WORLD_NAME'
    read -r -p 'New world slot name (never overwrites): ' new
  fi
  assert_name "$new"
  dest="$(world_dir "$new")"
  [[ ! -e "$dest" ]] || die "World slot already exists: $new"
  # Accept only archives created by this manager, with expected root members.
  tar -tzf "$archive" >/dev/null || die "Invalid tar archive"
  LC_ALL=C tar -tvzf "$archive" | awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d" {exit 1}' || die 'Archive contains links or special files'
  while IFS= read -r entry; do
    [[ "$entry" == profile || "$entry" == mods.env || "$entry" == deployment.txt || "$entry" == preset || "$entry" == server-rules.env || "$entry" == data || "$entry" == data/* || "$entry" == story || "$entry" == story/* ]] || die "Unsafe archive member: $entry"
    [[ "/$entry/" != */../* && "$entry" != *\\* ]] || die "Unsafe path in archive: $entry"
  done < <(tar -tzf "$archive")
  temp="$(mktemp -d "$WORLDS/.restore.XXXXXX")"
  tar --acls --xattrs --no-same-owner --no-same-permissions -xzf "$archive" -C "$temp"
  [[ -d "$temp/data" && -f "$temp/profile" ]] || die "Backup format invalid (partial restore preserved at $temp)"
  local profile
  IFS= read -r profile < "$temp/profile" || :
  [[ -f "$(profile_path "$profile")" ]] || die "Backup profile missing or unknown: $profile (temporary extraction remains at $temp)"
  [[ -f "$temp/mods.env" ]] && cmp -s "$temp/mods.env" "$(profile_path "$profile")" || die 'Archived mod profile differs from current configuration; restore held for review'
  [[ -f "$temp/deployment.txt" ]] || die 'Backup provenance is missing'
  if [[ -f "$temp/server-rules.env" ]]; then check_server_rules "$temp/server-rules.env"; fi
  if [[ -f "$temp/preset" ]]; then
    local archived_preset
    IFS= read -r archived_preset < "$temp/preset" || :
    [[ "$archived_preset" == auto || "$archived_preset" == imported ]] || assert_name "$archived_preset"
    if [[ "$archived_preset" != auto && "$archived_preset" != imported ]]; then
      [[ -f "$temp/data/Server/SiegerZomboid_SandboxVars.lua" ]] || die 'Sandbox snapshot missing from backup'
    fi
  fi
  if [[ -d "$temp/story" ]]; then
    # An archived story bundle belongs to the original world name. Recompile
    # from reviewed JSON with the NEW slot name, never execute a stale bundle.
    # Leave it disabled until an operator verifies scenes for the new world.
    if [[ -f "$temp/story/bundle.lua" ]]; then
      local disabled_bundle="$temp/story/bundle.lua.needs-review"
      [[ ! -e "$disabled_bundle" ]] || disabled_bundle+=".$BASHPID"
      mv "$temp/story/bundle.lua" "$disabled_bundle"
    fi
  fi
  # Archived live queues belong to the OLD world and must never replay in a
  # restored slot. This is independent of whether a Story bundle was active.
  if [[ -d "$temp/data/Lua" ]]; then
    for entry in SiegerStoryLiveRequest.txt SiegerStoryLiveResult.txt; do
      if [[ -f "$temp/data/Lua/$entry" ]]; then
        mv -- "$temp/data/Lua/$entry" "$temp/data/Lua/$entry.needs-review"
      fi
    done
  fi
  if [[ -f "$temp/story/live/session.json" ]]; then
    mv -- "$temp/story/live/session.json" "$temp/story/live/session.json.needs-review"
  fi
  mv -- "$temp" "$dest"
  note "Restored backup to new slot '$new' without modifying existing worlds. Start with: sudo pz start $new"
}

command_config() {
  (($# == 1)) || die 'Usage: pz config WORLD'
  local world="$1"
