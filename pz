  printf 'World: %s\n' "$world"
  printf 'Sandbox: %s\n' "$WORLDS/$world/data/Server/SiegerZomboid_SandboxVars.lua"
  printf 'Server INI: %s\n' "$WORLDS/$world/data/Server/SiegerZomboid.ini"
