}
command_export_preset() {
  (($# == 2)) || die 'Usage: pz export-preset WORLD NEW_PRESET_NAME'
  local world="$1" preset="$2" source dest
  assert_name "$world"
  assert_name "$preset"
  world_exists "$world" || die "Unknown world: $world"
  container_running && die 'Stop the game before exporting the sandbox snapshot'
  source="$WORLDS/$world/data/Server/SiegerZomboid_SandboxVars.lua"
  [[ -f "$source" && ! -L "$source" ]] || die "World has no generated sandbox file: $source"
  dest="$REPO/config/presets/$preset.lua"
  [[ ! -e "$dest" ]] || die "Preset already exists; will not overwrite: $dest"
  install -d -m 755 "$REPO/config/presets"
  cp -- "$source" "$dest"
  chmod 644 "$dest"
  # Validate the same format used when creating the next world.
  preset_path "$preset" >/dev/null || { rm -f -- "$dest"; die 'Preset verification failed'; }
  note "Sandbox snapshot exported to $dest. Review and commit it to Git after verification."
}
command_admin() {
  (($# == 2)) || die 'Usage: pz admin grant|revoke USERNAME'
  local action="$1" username="$2" role
  [[ "$action" == grant || "$action" == revoke ]] || die 'Usage: pz admin grant|revoke USERNAME'
  [[ "$username" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,30}$ ]] || die 'Unsafe username: only simple existing game account names are accepted'
  container_running || die 'Start the world first; target player must have created an account'
  local name
  name="$(active)"
  [[ -n "$name" ]] || die 'No active world'
  check_mount "$name"
  role=user
  [[ "$action" != grant ]] || role=admin
  note "Changing in-game role for $username to $role in world $name ..."
  rcon_command "setaccesslevel \"$username\" $role"
  note 'Rejoin to refresh permissions; this is not Linux sudo access.'
}
# The B42 native server teleportto command sends the game's actual network
# teleport packet. Never set IsoPlayer X/Y/Z directly from a server Lua mod.
# A root-owned CLI issues a single validated, quoted console command.
story_teleport() {
  (($#==5 || $#==6)) ||
    die 'Usage: pz story teleport WORLD EXACT_LOGIN X Y Z [--yes]'
  local world="$1" login="$2" x="$3" y="$4" z="$5" response
  (($#==5)) || [[ "$6" == --yes ]] ||
    die 'Only --yes is supported as a sixth argument'
  assert_name "$world"
  world_exists "$world" || die "Unknown world: $world"
  [[ "$login" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,30}$ ]] ||
    die 'Exact login required (letters, digits, _, ., - only)'
  [[ "$x" =~ ^-?(0|[1-9][0-9]{0,6})$ &&
     "$y" =~ ^-?(0|[1-9][0-9]{0,6})$ &&
     "$z" =~ ^-?(0|[1-9][0-9]?)$ ]] ||
    die 'Teleport coordinates must be integer world X/Y/Z'
  (( x>=-100000 && x<=1000000 && y>=-100000 && y<=1000000
      && z>=-16 && z<=32 )) ||
    die 'Teleport coordinates outside game integer map ranges'
  if (($#==5)); then
    note "PREVIEW native teleportto: world=$world player=$login to=$x,$y,$z"
    note 'No game command sent. Append --yes to teleport an online player.'
    return 0
  fi
  [[ "$(active)" == "$world" ]] || die "Active world differs from $world"
  container_running || die 'Start selected world before teleporting a player'
  check_mount "$world"
  response="$(rcon_command "teleportto \"$login\" $x,$y,$z")" ||
    die 'Native teleport RCON command failed; no success claim'
  [[ -n "$response" ]] || die 'Empty native teleport response; inspect logs and player position'
  if [[ "$response" =~ [Ee]rror|[Cc]annot|[Cc]an.?t|[Nn]ot[[:space:]]found|[Nn]ot[[:space:]]online|[Ii]nvalid|[Uu]nknown[[:space:]]command ]]; then
    die "Native teleport refused: $response"
  fi
  note "Native teleport RCON response: $response"
  note 'Server reply is not proof of client relocation; verify with ops players / client.'
}
story_live_python() {
  [[ -f "$REPO/story/livectl.py" ]] || die 'Story live session controller not installed'
  PZ_STORY_REPO_ROOT="$REPO" PZ_STORY_STORE_ROOT="$STORE" python3 "$REPO/story/livectl.py" "$@"
}
story_players_zero() {
  container_running || die 'Game must be running for live checkpoint'
  local players
  players="$(rcon_command players)" || die 'RCON players check unavailable; no shutdown permitted'
  [[ "$players" == 'Players connected (0):' ]] ||
    die "Checkpoint requires an empty server; RCON says: $players"
}
story_latest_backup() {
  local name="$1"
  [[ -d "$BACKUPS/$name" ]] || return 0
  find "$BACKUPS/$name" -maxdepth 1 -type f -name 'world-*.tar.gz' -printf '%T@\t%p\n' |
    LC_ALL=C sort -nr | sed -n '1{s/^[^\t]*\t//;p;}'
}
story_checkpoint() {
  local name="$1" kind="$2" before after
  [[ "$(active)" == "$name" ]] || die "Active world is not $name"
  check_mount "$name"
  story_players_zero
  before="$(story_latest_backup "$name")"
  note "Starting short maintenance for $kind snapshot of $name. Players connected: 0."
  stop_internal
  local rc=0
  backup_world "$name" || rc=$?
  after="$(story_latest_backup "$name")"
  if [[ "$rc" -eq 0 && -n "$after" && "$after" != "$before" ]]; then
    story_live_python clear-queue "$name" || rc=$?
  fi
  if [[ "$kind" == begin && "$rc" -eq 0 && -n "$after" && "$after" != "$before" ]]; then
    # Only after a cold backup is verified may the server's read-only Story
    # runtime be enabled for this particular world.
    PZ_STORY_REPO_ROOT="$REPO" PZ_STORY_STORE_ROOT="$STORE" \
      python3 "$REPO/story/storyctl.py" enable "$name" --yes || rc=$?
  fi
  note "Restarting the same world after the $kind maintenance window ..."
  start_internal "$name" || die 'Game restart failed after backup; STOP and investigate; no data deleted'
  [[ "$rc" == 0 && -n "$after" && "$after" != "$before" ]] ||
    die "Cold $kind snapshot failed or no new verified archive; game restarted, no session change"
  STORY_CHECKPOINT_ARCHIVE="$after"
}
story_live_begin() {
  (($#==2)) && [[ "$2" == --yes ]] || die 'Usage: pz story live-begin WORLD --yes'
  local name="$1"
  assert_name "$name"
  world_exists "$name" || die "World not found: $name"
  story_live_python check-new "$name" || die 'Another Story editing session is active'
  story_checkpoint "$name" begin
  story_live_python begin-record "$name" --backup "$STORY_CHECKPOINT_ARCHIVE"
}
story_live_commit() {
  (($#==2)) && [[ "$2" == --yes ]] || die 'Usage: pz story live-commit WORLD --yes'
  local name="$1"
  assert_name "$name"
  story_live_python pre-commit "$name" ||
    die 'Live changes are not fully acknowledged; cannot take commit checkpoint'
  story_checkpoint "$name" commit
  story_live_python commit-record "$name" --backup "$STORY_CHECKPOINT_ARCHIVE"
}
command_story() {
  [[ -f "$REPO/story/storyctl.py" ]] || die 'Story Director CLI missing from repository'
  export PZ_STORY_REPO_ROOT="$REPO" PZ_STORY_STORE_ROOT="$STORE"
  case "${1:-}" in
    teleport)
      shift
      story_teleport "$@" ;;
    atlas)
      shift
      if [[ "${1:-}" == analyze ]]; then
        shift
        python3 "$REPO/story/buildingdensity.py" "$@" 
      else
        python3 "$REPO/story/buildingatlas.py" "$@"
      fi ;;
    zombies)
      shift
      python3 "$REPO/story/zombiedebug.py" "$@" ;;
    time)
      shift
      python3 "$REPO/story/timecontrol.py" "$@" ;;
    clock)
      shift
      python3 "$REPO/story/clockctl.py" "$@" ;;
    backup-info)
      shift
      python3 -I "$REPO/story/backupctl.py" "$@" ;;
    live-begin) shift; story_live_begin "$@" ;;
    live-commit) shift; story_live_commit "$@" ;;
    apply-live|apply-once|live-status|retry-height) story_live_python "$@" ;;
    quest-status)
      shift
      [[ -f "$REPO/story/questctl.py" ]] || die 'Quest audit CLI missing'
      python3 "$REPO/story/questctl.py" "$@" ;;
    scan-player|scan-area|scan-status|scan-report)
      [[ -f "$REPO/story/scanctl.py" ]] || die 'Story AreaScan CLI missing'
      python3 "$REPO/story/scanctl.py" "$@" ;;
    player-inspect|player-status|player-grant|player-remove-tagged|player-heal)
      [[ -f "$REPO/story/playerctl.py" ]] || die 'Story PlayerControl CLI missing'
      python3 "$REPO/story/playerctl.py" "$@" ;;
    bar-zombies)
      shift
      [[ -f "$REPO/story/barctl.py" ]] || die 'Story BarControl CLI missing'
      python3 "$REPO/story/barctl.py" "$@" ;;
    bar-zombies-status)
      shift
      [[ -f "$REPO/story/barctl.py" ]] || die 'Story BarControl CLI missing'
      python3 "$REPO/story/barctl.py" status "$@" ;;
    character)
      shift
      python3 "$REPO/story/characterctl.py" "$@" ;;
    build)
      shift
      [[ -f "$REPO/story/constructionctl.py" ]] ||
        die 'Reviewed construction plan controller unavailable'
      python3 "$REPO/story/constructionctl.py" "$@" ;;
    batch)
      shift
      python3 "$REPO/story/batchctl.py" "$@" ;;
    vehicle)
      shift
      [[ -f "$REPO/story/vehiclectl.py" ]] || die 'Story VehicleControl CLI missing'
      python3 "$REPO/story/vehiclectl.py" "$@" ;;
    radio)
      shift
      [[ -f "$REPO/story/radioctl.py" ]] || die 'SiegerRadio CLI missing'
      python3 "$REPO/story/radioctl.py" "$@" ;;
    ops)
      shift
      [[ -f "$REPO/story/opsctl.py" ]] || die 'Story Ops read-only CLI missing'
      python3 "$REPO/story/opsctl.py" "$@" ;;
    tlou)
      shift
      [[ -f "$REPO/story/tlouctl.py" ]] || die 'Story TLOU diagnostics CLI missing'
      python3 "$REPO/story/tlouctl.py" "$@" ;;
    profile)
      shift
      [[ -f "$REPO/story/profilectl.py" ]] || die 'Story profiler missing'
      python3 "$REPO/story/profilectl.py" "$@" ;;
    *)
      python3 "$REPO/story/storyctl.py" "$@" ;;
  esac
}

main() {
  [[ "$(id -u)" == 0 ]] || die 'Run as root: sudo pz ... (Docker controls root-equivalent access)'
  [[ "$STORE" == /* && "$STORE" != / ]] || die 'PZ store root must be a non-root absolute path'
  [[ -f "$REPO/compose.yaml" && -f "$REPO/config/server.env" ]] || die "Not a PZ Compose repository: $REPO"
  install -d -m 700 "$WORLDS" "$BACKUPS" "$STATE"
  exec 9>"$LOCK"
  flock -n 9 || die 'Another PZ operation is in progress; retry later'
  local cmd="${1:-help}"
  (( $# == 0 )) || shift
  case "$cmd" in
    help|-h|--help) usage ;;
    start) command_start "$@" ;;
    stop) command_stop "$@" ;;
    save) command_save "$@" ;;
    save-live) command_save_live "$@" ;;
    load) command_load "$@" ;;
    create) command_create "$@" ;;
    import-legacy) command_import "$@" ;;
    admin) command_admin "$@" ;;
    story) command_story "$@" ;;
    config) command_config "$@" ;;
    export-preset) command_export_preset "$@" ;;
    list) command_list "$@" ;;
    status) command_status "$@" ;;
    logs) command_logs "$@" ;;
    *) usage; die "Unknown command: $cmd" ;;
  esac
}
main "$@"
