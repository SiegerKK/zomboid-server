# The Last of Us inspired private co-op; intentional PvP enabled by owner.
# Public listing off, but player registration allowed (no shared join password).
MAX_PLAYERS=6
PVP=true
PAUSE_EMPTY=true
PUBLIC=false
OPEN=true
SLEEP_ALLOWED=false
SLEEP_NEEDED=false

# Owner requested: high latency must not disconnect players. Other anti-cheat stays enabled.
PING_LIMIT=0
